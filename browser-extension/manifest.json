{
  "manifest_version": 3,
  "name": "PlaylistVault: Download locally",
  "description": "Send any playing video — YouTube, Udemy or direct MP4/M3U8 — to the local PlaylistVault desktop app.",
  "version": "1.1.0",
  "permissions": ["activeTab", "contextMenus", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Download playing video with PlaylistVault" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
