# Normalise line endings so clones on Windows/macOS/Linux stay consistent.
* text=auto eol=lf

# Windows-native scripts must keep CRLF or they break when executed.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat these as binary so git never mangles them.
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.exe binary
