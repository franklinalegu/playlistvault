{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/download",
      "destination": "/api/download"
    },
    {
      "source": "/download/latest",
      "destination": "/api/download"
    },
    {
      "source": "/download/mac",
      "destination": "/api/download?platform=mac"
    },
    {
      "source": "/download/windows/portable",
      "destination": "/api/download?platform=win&format=portable"
    },
    {
      "source": "/download/mac/intel",
      "destination": "/api/download?platform=mac&arch=x64"
    },
    {
      "source": "/download/mac/intel/zip",
      "destination": "/api/download?platform=mac&arch=x64&format=zip"
    },
    {
      "source": "/download/mac/apple-silicon",
      "destination": "/api/download?platform=mac&arch=arm64"
    },
    {
      "source": "/download/mac/apple-silicon/zip",
      "destination": "/api/download?platform=mac&arch=arm64&format=zip"
    },
    {
      "source": "/download/android",
      "destination": "/api/download?platform=android"
    }
  ]
}
